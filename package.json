{
  "name": "capri-companion",
  "version": "0.1.0-alpha.4",
  "private": true,
  "description": "Non-commercial Capri desktop and T3Code monitoring companion",
  "license": "PolyForm-Noncommercial-1.0.0",
  "main": "dist/main/bootstrap.cjs",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "npm run build && electron .",
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit && node scripts/check-repository.mjs && npm run build",
    "test": "vitest run && node --test tests/hooks.test.js",
    "test:core": "vitest run --project core --passWithNoTests",
    "test:contracts": "vitest run --project contracts --passWithNoTests",
    "test:e2e": "npm run build && node scripts/smoke.mjs && node scripts/overlay-smoke.mjs && node scripts/agent-smoke.mjs && node scripts/assistant-smoke.mjs",
    "test:overlay": "npm run build && node scripts/overlay-smoke.mjs",
    "test:packaged": "node scripts/overlay-smoke.mjs --packaged",
    "test:context-packaged": "node scripts/context-package-smoke.mjs",
    "dist": "npm run check && electron-builder --win && node scripts/check-package.mjs",
    "dist:unpacked": "npm run check && electron-builder --win --dir && node scripts/check-package.mjs",
    "test:agent": "npm run build && node scripts/agent-smoke.mjs",
    "showcase": "npm run build && electron . --showcase",
    "test:showcase": "npm run build && node scripts/showcase-smoke.mjs",
    "demo:agents": "npm run build && electron . --agent-demo",
    "test:assistant": "npm run build && node scripts/assistant-smoke.mjs",
    "test:assistant:archive": "node scripts/assistant-smoke.mjs --archive"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@types/node": "^22.0.0",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "fast-check": "4.10.2",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "effect": "4.1.2",
    "zod": "4.6.7"
  },
  "build": {
    "appId": "personal.capri.companion",
    "productName": "Capri Companion",
    "directories": {
      "output": "release"
    },
    "asarUnpack": [
      "dist/main/read-only.ps1",
      "dist/main/assistant-controls.ps1",
      "dist/main/input-jobs.ps1"
    ],
    "files": [
      "dist/**",
      "art/placeholder/**",
      "assistant/defaults/**",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "licenses/**",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "art/placeholder/pip.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "runAfterFinish": false,
      "artifactName": "Capri-Companion-Setup-${version}.${ext}"
    }
  }
}
